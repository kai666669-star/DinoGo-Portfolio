{$SITE_ADDRESS} {
    handle /api {
        reverse_proxy backend:8080
    }

    handle /api/* {
        reverse_proxy backend:8080
    }

    handle /uploads {
        reverse_proxy backend:8080
    }

    handle /uploads/* {
        reverse_proxy backend:8080
    }

    handle {
        reverse_proxy frontend:80
    }
}
