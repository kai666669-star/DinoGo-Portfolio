# SQL Server
MSSQL_PID=Developer
MSSQL_SA_PASSWORD=
DB_URL=jdbc:sqlserver://database:1433;databaseName=0901;encrypt=true;trustServerCertificate=true
DB_USERNAME=
DB_PASSWORD=

# Server PC team LAN SQL Server access (Server PC only; never use 0.0.0.0)
MSSQL_BIND_IP=
MSSQL_HOST_PORT=9434

# Team Docker client shared database (member workstation only)
SHARED_DB_HOST=
SHARED_DB_PORT=9434
SHARED_DB_NAME=0901

# Backend authentication
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
PASSWORD_RESET_SECRET=
PASSWORD_RESET_EXPIRATION_MS=900000
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=60000
PASSWORD_RESET_RATE_LIMIT_MAX_KEYS=10000

# Google OAuth (public client identifiers)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Mail
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=service.dinogo@gmail.com
SYSMSG_EMAIL_ENABLED=false
SYSMSG_EMAIL_BATCH_SIZE=50
SYSMSG_EMAIL_POLL_DELAY_MS=30000
SYSMSG_EMAIL_RETRY_DELAY_MS=60000
SYSMSG_EMAIL_MAX_ATTEMPTS=5
SYSMSG_RECONCILIATION_ENABLED=false
SYSMSG_RECONCILIATION_PAGE_SIZE=100
SYSMSG_RECONCILIATION_FIXED_DELAY_MS=60000
SYSMSG_OA_BATCH_SIZE=100

# Payment safety defaults
PAYMENT_SIMULATION_ENABLED=false
PAYMENT_EXPIRY_TIMEOUT_MINUTES=15
PAYMENT_EXPIRY_ENABLED=false
PAYMENT_EXPIRY_INITIAL_DELAY_MS=60000
PAYMENT_EXPIRY_FIXED_DELAY_MS=60000
ECPAY_ENABLED=false
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_CHECKOUT_URL=
ECPAY_RETURN_URL=
ECPAY_ORDER_RESULT_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional OpenAI sales insights (disabled by default)
APP_AI_OPENAI_ENABLED=false
APP_AI_OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Public routing
SITE_ADDRESS=:80
FRONTEND_BASE_URL=http://localhost:8088
